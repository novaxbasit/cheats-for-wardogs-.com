---
import { SITE_NAME } from '../config/site';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const trimmed = SITE_NAME.trim();
const lastSpace = trimmed.lastIndexOf(' ');
const lead = lastSpace > 0 ? `${trimmed.slice(0, lastSpace)} ` : trimmed;
const accent = lastSpace > 0 ? trimmed.slice(lastSpace + 1) : '';
---

<span class:list={['tracking-normal', className]} aria-hidden="true">
  {lead}
  {accent ? <span class="text-inherit">{accent}</span> : null}
</span>
