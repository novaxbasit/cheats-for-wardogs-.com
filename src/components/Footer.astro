---
import { useLocale } from '../i18n';
import { Separator } from '@/components/starwind/separator';
import BrandLogo from './BrandLogo.astro';
import { GAME } from '../config/game';
import { isProductHrefEnabled } from '../config/catalog';
const { t, lp } = useLocale(Astro.currentLocale);

const [trademarkBefore, trademarkAfter = ''] = t.footer.trademark.split('{game}');
const exploreLinks = t.footer.exploreLinks.filter((link) => isProductHrefEnabled(link.href));

const supportLinks = t.footer.supportLinks;

const legalLinks = [
  { href: '/about/', label: t.footer.about },
  { href: '/privacy/', label: t.footer.privacy },
  { href: '/terms/', label: t.footer.terms },
];
---

<footer class="border-t border-border bg-muted/30 py-16">
  <div class="mx-auto max-w-6xl px-5">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
      <div class="space-y-4">
        <a href={lp('/')} class="inline-flex items-center gap-2.5 font-[family-name:var(--font-heading)] text-lg font-bold" aria-label={`${t.site.name} home`}>
          <BrandLogo size={32} class="rounded-md" />
          <span class="text-base font-semibold text-foreground">{t.footer.homeLink}</span>
        </a>
        <p class="text-sm text-muted-foreground">{t.footer.tagline}</p>
      </div>

      <nav aria-label={t.footer.explore}>
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{t.footer.explore}</p>
        <ul class="mt-3 space-y-2">
          {exploreLinks.map((link) => (
            <li>
              <a
                href={lp(link.href)}
                class="nav-link text-sm text-muted-foreground hover:text-primary"
                data-nav-link
                {...(link.scrollTarget ? { 'data-scroll-target': link.scrollTarget } : {})}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label={t.footer.support}>
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{t.footer.support}</p>
        <ul class="mt-3 space-y-2">
          {supportLinks.map((link) => (
            <li>
              <a
                href={lp(link.href)}
                class="nav-link text-sm text-muted-foreground hover:text-primary"
                data-nav-link
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label={t.footer.legal}>
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{t.footer.legal}</p>
        <ul class="mt-3 space-y-2">
          {legalLinks.map((link) => (
            <li>
              <a href={lp(link.href)} class="text-sm text-muted-foreground hover:text-primary">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <Separator class="my-8" />
    <p class="text-left text-sm text-muted-foreground">
      &copy; {new Date().getFullYear()} {t.site.name} · {t.site.domain}
    </p>
    <p class="mt-2 text-left text-xs text-muted-foreground">
      {trademarkBefore}<a
        href={GAME.officialUrl}
        class="underline underline-offset-2 hover:text-primary"
        target="_blank"
        rel="noopener"
      >{GAME.name}</a>{trademarkAfter}
    </p>
  </div>
</footer>
