---
import type { ProductAcquisition, ProductSlide } from '../../data/products';
import { productAcquisitionStepIcons } from '../../data/sectionIcons';
import Icon from '../icons/Icon.astro';
import { useLocale } from '../../i18n';

interface Props {
  images: ProductSlide[];
  acquisition: ProductAcquisition;
  productName: string;
  experience?: {
    eyebrow: string;
    title: string;
    subtitle: string;
    previewLabel: string;
    accessDividerTop: string;
    accessDividerBottom: string;
  };
}

const { images, acquisition, productName, experience } = Astro.props;
const { locale, t } = useLocale(Astro.currentLocale);
const layerWord = { en: 'Layer', es: 'Capa', de: 'Ebene', fr: 'Couche' }[locale];
const xp = experience ??
  t.products.experience ?? {
  eyebrow: 'Experience',
  title: 'Loader layers · After checkout',
  subtitle:
    'Use the screenshots above for module layout; below is what each layer does and how portal access works after purchase.',
  previewLabel: 'In-game layers',
  accessDividerTop: 'Preview',
  accessDividerBottom: 'Access',
};

const calloutLabels = ['A', 'B', 'C', 'D', 'E', 'F'];
---

<section
  id="product-experience"
  class="product-experience border-y border-border py-14 md:py-16 lg:py-20"
  aria-labelledby="product-experience-title"
>
  <div class="mx-auto max-w-6xl px-5 md:px-6">
    <header class="product-experience__header">
      <p class="product-experience__eyebrow">{xp.eyebrow}</p>
      <h2 id="product-experience-title" class="product-experience__title">
        {xp.title}
      </h2>
      <p class="product-experience__subtitle">
        {xp.subtitle}
      </p>
    </header>

    <div class="product-experience__grid">
      <div class="product-experience__column product-experience__column--preview">
        <h3 class="product-experience__column-head" id="product-experience-preview-label">{xp.previewLabel}</h3>
        <ul class="product-experience__callouts list-none p-0" aria-labelledby="product-experience-preview-label">
          {
            images.map((slide, index) => (
              <li class="product-experience__callout">
                <span class="product-experience__callout-index" aria-hidden="true">
                  {calloutLabels[index] ?? '·'}
                </span>
                <div class="product-experience__callout-body">
                  <span class="product-experience__callout-tag">{layerWord} {calloutLabels[index] ?? index + 1}</span>
                  <h3 class="product-experience__callout-title">{slide.caption}</h3>
                  <p class="product-experience__callout-desc">{slide.captionDesc}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="product-experience__divider" aria-hidden="true">
        <span class="product-experience__divider-cap product-experience__divider-cap--top">{xp.accessDividerTop}</span>
        <span class="product-experience__divider-line" />
        <span class="product-experience__divider-cap product-experience__divider-cap--bottom">{xp.accessDividerBottom}</span>
      </div>

      <aside
        class="product-experience__column product-experience__column--access"
        aria-labelledby="product-experience-access-title"
      >
        <h3 class="product-experience__column-head" id="product-experience-access-title">
          {acquisition.title}
        </h3>
        <div class="product-experience__access-body">
          <ol class="product-experience__steps list-none p-0">
            {
              acquisition.steps.map((step, i) => (
                <li class="product-experience__step">
                  <span class="product-experience__step-marker">
                    <Icon name={productAcquisitionStepIcons[i] ?? 'acqCheck'} size={16} />
                  </span>
                  <div class="product-experience__step-copy">
                    <p class="product-experience__step-num">{step.num}</p>
                    <h4 class="product-experience__step-title">{step.title}</h4>
                    <p class="product-experience__step-desc">{step.desc}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </aside>
    </div>
  </div>
</section>
