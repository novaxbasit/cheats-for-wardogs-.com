---
import Icon from '../icons/Icon.astro';
import type { IconName } from '../icons/types';

interface Props {
  name: IconName;
  iconSize?: number;
  /** Square tile (default) or circle for timelines */
  shape?: 'square' | 'circle';
  class?: string;
}

const { name, iconSize = 18, shape = 'square', class: className } = Astro.props;
---

<span
  class:list={[
    'product-icon-well flex shrink-0 items-center justify-center bg-primary/10 text-primary',
    shape === 'circle' ? 'size-11 rounded-full ring-2 ring-primary/30' : 'size-10 rounded-xl',
    className,
  ]}
>
  <Icon name={name} size={iconSize} class="icon-app--primary" />
</span>
