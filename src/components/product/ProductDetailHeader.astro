---
import type { ProductPage } from '../../data/products';
import { Badge } from '@/components/starwind/badge';
import { GAME } from '../../config/game';

interface Props {
  product: ProductPage;
}

const { product } = Astro.props;
const isGameProduct = product.kind === 'tier';
---

<header class="product-detail-header space-y-4">
  <div class="flex flex-wrap items-center gap-2">
    <Badge variant="secondary">{product.badge}</Badge>
    {product.variant === 'popular' && <Badge>Popular</Badge>}
    {product.variant === 'limited' && <Badge variant="warning">Limited</Badge>}
    {isGameProduct && <Badge variant="outline">{GAME.shortName}</Badge>}
    {product.category && !isGameProduct && <Badge variant="outline">{product.category}</Badge>}
  </div>
  <h1 class="max-w-3xl text-3xl font-bold normal-case leading-tight text-foreground md:text-4xl">{product.title}</h1>
  <p class="max-w-2xl text-lg leading-relaxed text-muted-foreground">{product.subtitle || product.desc}</p>
</header>
