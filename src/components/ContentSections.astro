---
import { useLocale } from '../i18n';

const { locale, t, lp } = useLocale(Astro.currentLocale);
import WorkflowSection from './WorkflowSection.astro';
import SectionHeader from './SectionHeader.astro';
import Icon from './icons/Icon.astro';
import { ROUTES } from '../utils/path';
import SiteFaqSection from './SiteFaqSection.astro';
import { getLandingFaqs } from '../data/faq';
import { getBlogPosts } from '../data/blog';
import BlogCard from './BlogCard.astro';
import { Button } from '@/components/starwind/button';

const homeFaqs = getLandingFaqs(locale);
const recentPosts = getBlogPosts(locale).slice(0, 3);
const f = t.pages.forum;
---

<WorkflowSection />

<section id="blog" class="border-y border-border bg-muted/20 py-16 md:py-24" aria-labelledby="blog-title">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeader eyebrow={t.blog.eyebrow} title={t.blog.title} desc={t.blog.subtitle} titleId="blog-title" />

    {
      recentPosts.length > 0 ? (
        <div class="fill-grid mt-12 gap-8 lg:gap-y-10" data-reveal-stagger>
          {recentPosts.map((post, index) => (
            <BlogCard post={post} index={index} showDate />
          ))}
        </div>
      ) : (
        <p class="mt-10 text-center text-muted-foreground" data-reveal="fade">
          {t.blog.emptyArchive}
        </p>
      )
    }

    <div class="mt-10 flex flex-wrap justify-start gap-3 lg:justify-center" data-reveal>
      <Button as="a" href={lp(ROUTES.blog)} variant="outline">
        {t.blog.viewAll}
        <Icon name="arrowRight" size={17} />
      </Button>
      <Button as="a" href={lp(ROUTES.forum)} variant="outline">
        {f.title}
        <Icon name="messageCircle" size={17} />
      </Button>
    </div>
  </div>
</section>

<SiteFaqSection id="faq" titleId="faq-title" items={homeFaqs} />
