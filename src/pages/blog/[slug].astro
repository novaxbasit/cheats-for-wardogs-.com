---
import '../../styles/blog-pages.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useLocale } from '../../i18n';

const { locale, t, lp } = useLocale(Astro.currentLocale);
import { getAllBlogSlugs, getBlogPost, getRelatedBlogPosts } from '../../data/blog';
import { canonicalUrl, pageTitle, SITE_ORIGIN } from '../../config/seo';
import {
  articleSchema,
  breadcrumbSchema,
  parseBlogDate,
} from '../../utils/schema';
import { HWID_CHECKOUT_PATH, PRIMARY_CHECKOUT_PATH, resolveCheckoutHref } from '../../config/checkout';
import { HWID_SPOOFER_SLUG, isUtilityEnabled } from '../../config/catalog';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import BlogSidebar from '../../components/BlogSidebar.astro';
import BlogPostTopBar from '../../components/BlogPostTopBar.astro';
import { getBlogFaqs } from '../../data/faq';
import SiteFaqSection from '../../components/SiteFaqSection.astro';
import Icon from '../../components/icons/Icon.astro';
import type { BlogBlock } from '../../data/blog';
import { Badge } from '@/components/starwind/badge';
import { Button } from '@/components/starwind/button';
import { Prose } from '@/components/starwind/prose';
import BlogPostCta from '../../components/BlogPostCta.astro';
import { normalizeInternalPath, ROUTES } from '../../utils/path';

export function getStaticPaths() {
  return getAllBlogSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const post = getBlogPost(slug!, locale);

if (!post) {
  return Astro.redirect(lp('/blog/'));
}

const postPath = `/blog/${post.slug}/`;
const breadcrumbs = [
  { name: t.common.breadcrumbHome, path: '/' },
  { name: t.common.breadcrumbBlog, path: '/blog/' },
  { name: post.title, path: postPath },
];

const related = getRelatedBlogPosts(post.slug, 3, locale);

function linkify(text: string | undefined): string {
  if (!text) return '';
  return text
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_match, label: string, href: string) => {
      const normalized = normalizeInternalPath(resolveCheckoutHref(href));
      return `<a href="${lp(normalized)}">${label}</a>`;
    })
    .replace(new RegExp(`(${SITE_ORIGIN.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}[^\\s.,;)]*)`, 'g'), (_match, url: string) => {
      const path = url.replace(SITE_ORIGIN, '');
      const normalized = normalizeInternalPath(path);
      const href = normalized.startsWith('http') ? normalized : `${SITE_ORIGIN}${normalized}`;
      return `<a href="${href}">${url}</a>`;
    });
}

function slugify(text: string): string {
  return text
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}
const published = parseBlogDate(post.date);
const documentTitle = post.metaTitle ?? pageTitle(post.title, undefined, locale);
const documentDescription = post.metaDescription ?? post.desc;
const heroAlt = post.imageAlt ?? post.title;
const heroWidth = post.imageWidth ?? 960;
const heroHeight = post.imageHeight ?? 540;
---

<BaseLayout
  title={documentTitle}
  description={documentDescription}
  canonicalPath={lp(postPath)}
  ogType="article"
  articlePublishedTime={published}
  articleModifiedTime={published}
  jsonLd={[
    articleSchema({
      name: post.title,
      description: documentDescription,
      url: canonicalUrl(lp(postPath)),
      image: post.image,
      datePublished: published,
      locale,
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <article class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />

      <BlogPostTopBar post={post} class="mt-6" />

      <div class="blog-article__layout mt-4 grid gap-6 lg:grid-cols-[minmax(14rem,16.5rem)_minmax(0,1fr)] lg:items-start lg:gap-8 xl:grid-cols-[17.5rem_minmax(0,1fr)]">
        <BlogSidebar post={post} related={related} class="order-2 lg:order-1" />

        <div class="order-1 min-w-0 lg:order-2">
          <figure class="blog-article__hero">
            <ResponsiveImage
              src={post.image}
              alt={heroAlt}
              width={heroWidth}
              height={heroHeight}
              loading="eager"
              fetchPriority="high"
              sizes="(min-width: 1024px) 720px, calc(100vw - 2.5rem)"
              phoneWidth={400}
              class="w-full object-cover"
            />
          </figure>

          <header class="blog-article__header">
            <h1 class="blog-article__title">{post.title}</h1>
            <p class="blog-article__lead">{post.desc}</p>
            {
              post.author && (
                <p class="blog-article__byline">
                  <Icon name="users" size={14} />
                  {post.author}
                </p>
              )
            }
          </header>

          <Prose class="blog-article__prose prose-headings:scroll-mt-24 max-w-none text-left">
            {post.body.map((block: BlogBlock) => {
              if (block.type === 'h2') {
                const id = slugify(block.text);
                return <h2 id={id}>{block.text}</h2>;
              }
              if (block.type === 'h3') {
                const id = slugify(block.text);
                return <h3 id={id}>{block.text}</h3>;
              }
              if (block.type === 'ul') {
                return (
                  <ul>
                    {block.items.map((item) => (
                      <li set:html={linkify(item)} />
                    ))}
                  </ul>
                );
              }
              if (block.type === 'table') {
                return (
                  <div class="overflow-x-auto">
                    <table>
                      <thead>
                        <tr>
                          {block.headers.map((header) => (
                            <th>{header}</th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {block.rows.map((row) => (
                          <tr>
                            {row.map((cell) => (
                              <td set:html={linkify(cell)} />
                            ))}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                );
              }
              if (block.type === 'cta') {
                return (
                  <BlogPostCta
                    title={block.title}
                    html={linkify(block.text)}
                    href={resolveCheckoutHref(block.href)}
                  />
                );
              }
              return <p set:html={linkify(block.text)} />;
            })}
          </Prose>

          <nav class="blog-article__actions" aria-label={t.blog.articleActionsAria}>
            <Button as="a" href={PRIMARY_CHECKOUT_PATH} variant="primary">
              {t.blog.buyCta}
              <Icon name="arrowRight" size={17} />
            </Button>
            {isUtilityEnabled(HWID_SPOOFER_SLUG) && (
              <Button as="a" href={HWID_CHECKOUT_PATH} variant="outline">
                {t.blog.buyHwidCta}
                <Icon name="arrowRight" size={17} />
              </Button>
            )}
            <Button as="a" href={lp(ROUTES.productsHub)} variant="outline">
              {t.notFound.viewProducts}
            </Button>
            <Button as="a" href={lp(ROUTES.blog)} variant="outline">
              {t.blog.moreArticles}
              <Icon name="arrowRight" size={17} />
            </Button>
          </nav>
        </div>
      </div>
    </div>
  </article>

  <SiteFaqSection
    items={getBlogFaqs(post.tag, post.slug, locale)}
    titleId={`blog-faq-${post.slug}`}
    class="border-t border-border bg-muted/20"
  />
</BaseLayout>
