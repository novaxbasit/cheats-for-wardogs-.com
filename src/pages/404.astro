---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useLocale } from '../i18n';
import Icon from '../components/icons/Icon.astro';
import { Button } from '@/components/starwind/button';
import { ROUTES } from '../utils/path';

const { t, lp } = useLocale(Astro.currentLocale);
---

<BaseLayout
  title={`${t.notFound.title} | ${t.site.name}`}
  description={t.notFound.metaDescription}
  noindex={true}
>
  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-lg px-5 text-center">
      <p class="text-sm font-semibold uppercase tracking-wider text-primary">404</p>
      <h1 class="mt-3 text-3xl font-bold uppercase text-foreground md:text-4xl">{t.notFound.title}</h1>
      <p class="mt-4 text-muted-foreground" data-reveal>{t.notFound.body}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center" data-reveal-stagger>
        <Button as="a" href={lp(ROUTES.home)} variant="primary">
          {t.notFound.backHome}
          <Icon name="arrowRight" size={17} />
        </Button>
        <Button as="a" href={lp(ROUTES.productsHub)} variant="outline">{t.notFound.viewProducts}</Button>
        <Button as="a" href={lp(ROUTES.productsElite)} variant="outline">{t.notFound.viewElite}</Button>
      </div>
    </div>
  </section>
</BaseLayout>
